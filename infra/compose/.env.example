# ---------------------------------------------------------------------------
# PrompTrading configuration. Copy to `.env` and fill in.
#   cp infra/compose/.env.example infra/compose/.env
# Never commit the resulting `.env`.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# Fernet key encrypting exchange API credentials at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRADING_API_ENCRYPTION_KEY=

# Database URL (optional, defaults to sqlite:////workspaces/app.db)
# APP_DB_URL=sqlite:////workspaces/app.db

# --- LLM provider ---------------------------------------------------------
# Any OpenAI-compatible endpoint works. Example below targets DeepSeek.

LLM_API_KEY=
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_HTTP_TIMEOUT_S=300
LLM_STREAM_TIMEOUT_S=600

# Emit a template strategy instead of failing the job when the LLM errors.
LLM_FALLBACK_ON_ERROR=false

# Provider-specific overrides (optional; leave blank if unused).
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_TEMPERATURE=

# Per-service timeout overrides (optional).
API_LLM_HTTP_TIMEOUT_S=
API_LLM_STREAM_TIMEOUT_S=
AGENT_LLM_HTTP_TIMEOUT_S=
AGENT_LLM_STREAM_TIMEOUT_S=

# --- Proxy configuration (optional) ---------------------------------------
# If you run a local proxy on the host machine (e.g. Clash, Surge, v2ray),
# route container outbound traffic (LLM, exchange APIs) through it.
# Docker containers reach the host via host.docker.internal.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# CONTAINER_HTTP_PROXY=http://host.docker.internal:7890
# CONTAINER_HTTPS_PROXY=http://host.docker.internal:7890
HTTP_PROXY=
HTTPS_PROXY=
CONTAINER_HTTP_PROXY=
CONTAINER_HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,api,worker,worker-rpc,web

# --- Deployment -----------------------------------------------------------

APP_PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated emails granted admin rights in the console.
APP_ADMIN_EMAILS=
# Shared secret for admin-only HTTP endpoints.
APP_ADMIN_API_KEY=

# Image tag used by the compose stacks.
IMAGE_TAG=latest

# --- Observability (optional) --------------------------------------------
# Langfuse prompt/cost tracing. Leave blank to disable.

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=development

# --- Sign-in and repo sync (optional) ------------------------------------

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_ORG=

REPO_SYNC_INTERVAL_S=300
